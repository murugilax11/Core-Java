public class Queue_ {
public static void main(String[] args) {
	Queue<Integer> q = new LinkedList<>(Arrays.asList(1,2,3,4,5));
	int size = q.size();
	int arr[] = new int[size];
	for(int i=0; i<size;i++) {
		arr[i] = q.poll();
	}
	for(int i =size-1;i>=0;i--) {
		q.offer(arr[i]);
	}
	System.out.print(q);
}
}
