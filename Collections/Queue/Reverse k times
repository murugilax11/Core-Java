public class Queue_ {
public static void main(String[] args) {
Queue<Integer> q = new LinkedList<>(Arrays.asList(1,2,3,4,5));
        int k = 3;
        Stack<Integer> st = new Stack<>(); 
        for(int i=0;i<k;i++)
          st.push(q.poll());
        while(!st.isEmpty())
          q.offer(st.pop());
        for(int i=0;i<q.size()-k;i++)
          q.offer(q.poll());
     System.out.println(q);
}
}
