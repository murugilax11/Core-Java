public class Map_ {
public static void main(String[] args) {
	HashMap<String,Integer> map = new HashMap<>();
			map.put("A",10);
			map.put("B",50);
			map.put("C",20);
			String key = "";
			int max = Integer.MIN_VALUE;
			for(Map.Entry<String,Integer> e :map.entrySet()) {
			    if(e.getValue() > max) {
			        max = e.getValue();
			        key = e.getKey();
			    }
			}
			System.out.println(key);
}
}
