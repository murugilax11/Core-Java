import java.util.*;
public class Set {
	public static void main(String[] args) {
		HashSet<Integer> s1 =new HashSet<>(Arrays.asList(1,2,3,4));
		HashSet<Integer> s2 =new HashSet<>(Arrays.asList(3,4,5));
        for(int num:s2) {
        	if(s1.contains(num)) {
        		System.out.print(num+" ");
        	}
        }
	}

}
