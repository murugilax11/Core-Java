package reviseJava;
public class badgeID {
	public static void main(String args[]) {
     int[] arr = {1,2,2,4,5};
     int dup = 0;
     int mis =0 ;
     for(int i =0; i<arr.length-1;i++) {
    	 if(arr[i] == arr[i+1]) {
    		 dup = arr[i];
    	 }
    	 
     }
     for(int i = 0; i < arr.length; i++) {
         if(arr[i] != i + 1) {
             mis = i + 1;
             break;
         }
     }
     System.out.println("Duplicate = "+dup);
     System.out.println("Missing = "+mis);
}
}
