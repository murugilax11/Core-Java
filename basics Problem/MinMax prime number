package reviseJava;
import java.util.*;
public class MinMaxPrime {
	static boolean isPrime(int num) {
		 if(num<=1) {
			 return false;
		 }
		 for(int i=2;i*i<=num;i++) {
			 if(num % i == 0 ) {
				 return false;
			 }
		 }
		 return true;
	 }
	static int primeDifference(int[] arr) {
        TreeSet<Integer> set = new TreeSet<>();
        for(int num : arr) {
            if(isPrime(num)) {
                set.add(num);
            }
        }
        if(set.size() <= 1) {
            return 0;
        }
        return set.last() - set.first();
    }
    public static void main(String[] args) {
        int[] arr = {5,5};
        System.out.println(primeDifference(arr));

	}

}
