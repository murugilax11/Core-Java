class Main {
    public static void main(String[] args) {
     int[] arr = {-2,1,-3,4,-1,2,1,-5,4};
     int cursum =0;
     int max = Integer.MIN_VALUE;
     for(int i =0; i<arr.length;i++){
         cursum += arr[i];
         if(cursum>max){
             max = cursum;
         }if(cursum<0){
             cursum =0;
         }
     }
     System.out.print(max);
    }
}
