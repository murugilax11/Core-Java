class Main {
    public static void main(String[] args) {
    int[] arr = {2, 5, 1, 8, 2, 9, 1};
        int k = 3;
        int sum =0;
        for(int i=0;i<k;i++){
            sum+=arr[i];
        }
        int max = sum;
        for(int i =k;i<arr.length;i++){
            sum = sum-arr[i-k]+arr[i];
            if(max<sum){
                max = sum;
            }
        }
        System.out.print(max);
    }
}
