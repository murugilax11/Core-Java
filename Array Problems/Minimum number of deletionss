import java.util.*;
class Main {
    static int gcd(int a, int b){
        if(b == 0) return a;
        return gcd(b, a%b);
    }
    public static void main(String[] args) {
       int[] nums = {2,3,2,4,3}, numsDivide = {9,6,9,3,15};
       int n = nums.length;
       int m = numsDivide.length;
       Arrays.sort(nums);
       int initial = numsDivide[0];
       for(int i =1;i<m;i++){
           initial = gcd(initial,numsDivide[i]);
       }
       for(int  i=0; i<n ; i++){
           if(initial % nums[i] == 0){
               System.out.print("deletion "+ i);
               return;
           }
       }
       System.out.print("-1");
    }
}
